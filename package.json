{
  "name": "organizer-butler",
  "version": "0.1.2",
  "description": "A local-first desktop file organizer with bounded Codex classification.",
  "author": "Organizer Butler",
  "private": true,
  "type": "module",
  "main": ".vite/build/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-forge start",
    "dev:cli": "tsx src/cli/index.ts",
    "mcp": "tsx src/mcp/index.ts",
    "organize": "tsx src/cli/index.ts scan",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "smoke:package": "\"out/Organizer Butler-darwin-arm64/Organizer Butler.app/Contents/MacOS/organizer-butler\" --smoke-test",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "verify": "npm run typecheck && npm test && npm run package"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openai/codex-sdk": "0.147.0",
    "pdf-lib": "^1.17.1",
    "saxes": "^6.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@types/node": "^24.0.0",
    "electron": "43.4.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "8.2.1"
  }
}
